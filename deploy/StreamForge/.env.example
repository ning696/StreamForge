# 1Panel HTTPS/WSS domains
APP_DOMAIN=meet.example.com
LIVEKIT_DOMAIN=livekit.example.com

# StreamForge frontend upstream port. 1Panel OpenResty owns public ports 80/443.
FRONTEND_PORT=8088

# MySQL
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=streamforge
MYSQL_USERNAME=streamforge
MYSQL_PASSWORD=change-me

# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# LiveKit
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=please-change-to-a-long-random-secret
LIVEKIT_TOKEN_TTL_SECONDS=86400
